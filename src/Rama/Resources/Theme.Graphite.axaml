<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Rama: tema grafito. Se mezcla despues de Themes.axaml y sobrescribe Color.* (ver docs/THEME-MAPPING.md). -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <!-- Acento unico -->
      <Color x:Key="SystemAccentColor">#FFE6A23C</Color>
      <Color x:Key="SystemAccentColorLight1">#FFEFB055</Color>
      <Color x:Key="SystemAccentColorLight2">#FFF0C27A</Color>
      <Color x:Key="SystemAccentColorLight3">#FFF5D6A4</Color>
      <Color x:Key="SystemAccentColorDark1">#FFC98A2B</Color>
      <Color x:Key="SystemAccentColorDark2">#FFA87122</Color>
      <Color x:Key="SystemAccentColorDark3">#FF7F5519</Color>
      <Color x:Key="SystemListLowColor">#FF25272B</Color>
      <Color x:Key="SystemListMediumColor">#FF2C2E33</Color>

      <!-- Superficies -->
      <Color x:Key="Color.Window">#FF17181A</Color>
      <Color x:Key="Color.WindowBorder">#FF2C2E33</Color>
      <Color x:Key="Color.TitleBar">#FF17181A</Color>
      <Color x:Key="Color.ToolBar">#FF1D1E21</Color>
      <Color x:Key="Color.Popup">#FF25272B</Color>
      <Color x:Key="Color.PopupBorder">#FF3A3D43</Color>
      <Color x:Key="Color.Contents">#FF1D1E21</Color>
      <Color x:Key="Color.SubPanel">#FF25272B</Color>
      <Color x:Key="Color.Badge">#FF2C2E33</Color>
      <Color x:Key="Color.BadgeFG">#FFECECEC</Color>

      <!-- Conflictos -->
      <Color x:Key="Color.Conflict">#FF2A2416</Color>
      <Color x:Key="Color.Conflict.Foreground">#FFF0C27A</Color>
      <Color x:Key="Color.Conflict.MineBG">#405AA9E6</Color>
      <Color x:Key="Color.Conflict.TheirsBG">#40E6A23C</Color>

      <!-- Bordes y botones planos -->
      <Color x:Key="Color.Border0">#FF222327</Color>
      <Color x:Key="Color.Border1">#FF3A3D43</Color>
      <Color x:Key="Color.Border2">#FF2C2E33</Color>
      <Color x:Key="Color.FlatButton.Background">#FF25272B</Color>
      <Color x:Key="Color.FlatButton.BackgroundHovered">#FF2C2E33</Color>
      <Color x:Key="Color.FlatButton.FloatingBorder">#FF3A3D43</Color>

      <!-- Texto -->
      <Color x:Key="Color.FG1">#FFECECEC</Color>
      <Color x:Key="Color.FG2">#FFA9ABB1</Color>

      <!-- Diff -->
      <Color x:Key="Color.Diff.EmptyBG">#40000000</Color>
      <Color x:Key="Color.Diff.AddedBG">#FF17301F</Color>
      <Color x:Key="Color.Diff.DeletedBG">#FF34191F</Color>
      <Color x:Key="Color.Diff.AddedHighlight">#FF24502F</Color>
      <Color x:Key="Color.Diff.DeletedHighlight">#FF5A2533</Color>
      <Color x:Key="Color.Diff.BlockBorderHighlight">#FFE6A23C</Color>

      <!-- Enlaces y codigo en linea -->
      <Color x:Key="Color.Link">#FF5AA9E6</Color>
      <Color x:Key="Color.InlineCode">#FF2C2E33</Color>
      <Color x:Key="Color.InlineCodeFG">#FFECECEC</Color>

      <!-- Texto sobre acento ambar: tinta oscura (contraste) -->
      <Color x:Key="Color.OnAccent">#FF1C1406</Color>
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF1C1406"/>
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF1C1406"/>
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FF1C1406"/>
      <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FF1C1406"/>

      <!-- Seleccion neutra en listas y grillas (el ambar queda para HEAD/primario/foco) -->
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#FF2C2E33"/>
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#FF33363B"/>
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#FF33363B"/>
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedDisabled" Color="#FF25272B"/>
      <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#FF25272B"/>
      <SolidColorBrush x:Key="ListBoxItemForegroundSelected" Color="#FFECECEC"/>
      <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPointerOver" Color="#FFECECEC"/>
      <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#FF2C2E33"/>
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#FF33363B"/>
      <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#FF2C2E33"/>
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#FF33363B"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- F4b: resolución de conflictos (tokens de docs/mockups/Conflict.html) -->
  <SolidColorBrush x:Key="Brush.Rama.Amber" Color="#FFE6A23C"/>
  <SolidColorBrush x:Key="Brush.Rama.AmberInk" Color="#FF1C1406"/>
  <SolidColorBrush x:Key="Brush.Rama.Mint" Color="#FF5CC58A"/>
  <SolidColorBrush x:Key="Brush.Rama.Faint" Color="#FF8C8F96"/>
  <SolidColorBrush x:Key="Brush.Rama.Conflict.OursBG" Color="#FF2A2416"/>
  <SolidColorBrush x:Key="Brush.Rama.Conflict.TheirsBG" Color="#FF17301F"/>
  <SolidColorBrush x:Key="Brush.Rama.Conflict.MarkerBG" Color="#FF3A2F1A"/>
  <SolidColorBrush x:Key="Brush.Rama.Conflict.MarkerFG" Color="#FFF0C27A"/>
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF1C1406"/>
  <SolidColorBrush x:Key="Brush.FG3" Color="#FF8C8F96"/>
</ResourceDictionary>
