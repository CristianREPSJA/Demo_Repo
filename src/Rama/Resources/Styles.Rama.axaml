<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Rama: overrides de estilo sobre Styles.axaml (se mezcla despues). Ver docs/THEME-MAPPING.md. -->

  <Styles.Resources>
    <!-- Glifo de terminal (maqueta, viewBox 16x16) -->
    <StreamGeometry x:Key="Rama.Icon.Terminal">M3,2.5 H13 A1.5,1.5 0 0 1 14.5,4 V12 A1.5,1.5 0 0 1 13,13.5 H3 A1.5,1.5 0 0 1 1.5,12 V4 A1.5,1.5 0 0 1 3,2.5 Z M4.5,6 L6.5,8 L4.5,10 M8.5,10.5 H11.5</StreamGeometry>
  </Styles.Resources>

  <!-- Encabezados: sentence case 12px apagados, sin negrita -->
  <Style Selector="TextBlock.table_header">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="TextBlock.tab_header">
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="TextBlock.info_label">
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>

  <!-- SHA: mono tenue -->
  <Style Selector="TextBlock.sha_faint">
    <Setter Property="FontFamily" Value="{DynamicResource Fonts.Monospace}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.FG3}"/>
  </Style>

  <!-- Seleccion neutra (#2c2e33) en listas y filas del historial; el ambar queda para HEAD/primario/foco -->
  <Style Selector=":is(ListBox) ListBoxItem:selected /template/ Border#PART_Background">
    <Setter Property="Background" Value="{DynamicResource Brush.Badge}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector=":is(ListBox):focus-within ListBoxItem:selected /template/ Border#PART_Background">
    <Setter Property="Background" Value="{DynamicResource Brush.Badge}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector=":is(ListBox):focus-within ListBoxItem:selected:pointerover /template/ Border#PART_Background">
    <Setter Property="Background" Value="{DynamicResource Brush.Badge}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource Brush.Badge}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource Brush.Badge}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="DataGridRow:selected:focus /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource Brush.Badge}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="DataGridRow:selected /template/ DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
  </Style>

  <!-- Boton primario unico: ambar con texto oscuro -->
  <Style Selector="Button.flat.primary">
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Revisiones pendientes (clases rv-*) -->
  <Style Selector="Border.rv-card">
    <Setter Property="Background" Value="{DynamicResource Brush.Contents}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border1}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="TextBlock.rv-h3">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
  </Style>
  <Style Selector="TextBlock.rv-muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.rv-faint">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.FG3}"/>
  </Style>
  <Style Selector="TextBlock.rv-mono">
    <Setter Property="FontFamily" Value="{DynamicResource Fonts.Monospace}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="TextBlock.rv-error">
    <Setter Property="Foreground" Value="#ee9ab1"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="Border.rv-pill">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.rv-pill > TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.rv-avatar">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>
  <Style Selector="Border.rv-avatar > TextBlock">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.rv-item">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="28,8,12,8"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.rv-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Popup}"/>
  </Style>
  <Style Selector="Button.rv-item.sel /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2C2E33"/>
  </Style>
  <Style Selector="Button.rv-tab">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0,0,0,2"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="2,0"/>
    <Setter Property="Margin" Value="0,0,20,0"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
  </Style>
  <Style Selector="Button.rv-tab.sel">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.FG1}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Button.rv-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.rv-ghost-amber">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="Height" Value="32"/>
  </Style>
  <Style Selector="Button.rv-ghost-amber:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2C2E33"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
  </Style>
  <Style Selector="Border.rv-skel">
    <Setter Property="Background" Value="#25272B"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
</Styles>
