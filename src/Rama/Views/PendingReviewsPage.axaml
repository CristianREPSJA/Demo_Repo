<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SourceGit.Views.PendingReviewsPage">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="420">
    <TextBlock Text="Revisiones pendientes" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.FG1}" HorizontalAlignment="Center"/>
    <TextBlock Text="Conecta tu organización de Azure DevOps para ver lo que espera tu aprobación." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Brush.FG2}"/>
  </StackPanel>
</UserControl>
