<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="700"
             x:Class="SourceGit.Views.PullRequestDetailView"
             x:DataType="vm:PullRequestDetailViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,16" Spacing="12">
      <!-- Cabecera -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.FG1}" TextWrapping="Wrap" MaxWidth="520"/>
            <TextBlock Classes="rv-mono rv-faint" Text="{Binding Number}" VerticalAlignment="Bottom"/>
          </StackPanel>
          <TextBlock Classes="rv-muted" Text="{Binding Headline}"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="16,0,0,0">
          <StackPanel Orientation="Horizontal" IsVisible="{Binding CanVote}">
            <Button Classes="flat primary" Content="{Binding PrimaryVote.Label}" Command="{Binding VoteCommand}"
                    CommandParameter="{Binding PrimaryVote}" IsEnabled="{Binding IsIdle}" Height="32" Padding="16,0"
                    CornerRadius="6,0,0,6"/>
            <Button Classes="flat primary" Height="32" Padding="8,0" CornerRadius="0,6,6,0" BorderThickness="1,0,0,0"
                    IsEnabled="{Binding IsIdle}" ToolTip.Tip="{DynamicResource Text.Rama.Reviews.MoreVotes}"
                    AutomationProperties.Name="{DynamicResource Text.Rama.Reviews.MoreVotes}">
              <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Brush.OnAccent}" StrokeThickness="1.5"
                    StrokeLineCap="Round" StrokeJoin="Round" Data="M4,6 L8,10 L12,6"/>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem x:DataType="vm:PullRequestDetailViewModel" Header="{Binding OtherVotes[0].Label}"
                            Command="{Binding VoteCommand}" CommandParameter="{Binding OtherVotes[0]}"/>
                  <MenuItem x:DataType="vm:PullRequestDetailViewModel" Header="{Binding OtherVotes[1].Label}"
                            Command="{Binding VoteCommand}" CommandParameter="{Binding OtherVotes[1]}"/>
                  <Separator/>
                  <MenuItem x:DataType="vm:PullRequestDetailViewModel" Header="{Binding OtherVotes[2].Label}"
                            Foreground="#ee9ab1" Command="{Binding VoteCommand}" CommandParameter="{Binding OtherVotes[2]}"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <StackPanel Spacing="2">
            <Button Content="{DynamicResource Text.Rama.Reviews.Complete}" Command="{Binding OpenInAzureCommand}"
                    IsEnabled="{Binding CanComplete}" Height="32"/>
            <TextBlock Classes="rv-faint" Text="{Binding CompleteReason}" IsVisible="{Binding HasCompleteReason}"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Confirmación inline -->
      <Border IsVisible="{Binding HasConfirm}" Classes="rv-card" Padding="12,8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding ConfirmPrompt}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG1}"/>
          <Button Classes="flat primary" Content="{DynamicResource Text.Rama.Reviews.Confirm.Yes}" Command="{Binding ConfirmCommand}"/>
          <Button Content="{DynamicResource Text.Rama.Reviews.Confirm.No}" Command="{Binding CancelConfirmCommand}"/>
        </StackPanel>
      </Border>

      <!-- Error del bloque -->
      <Border IsVisible="{Binding HasError}" Classes="rv-card" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="rv-error" Text="{Binding ErrorMessage}"/>
          <TextBlock Classes="rv-muted" Text="{Binding ScopeHint}" IsVisible="{Binding HasScopeHint}"/>
          <Button Command="{Binding RetryCommand}" Content="{DynamicResource Text.Rama.Reviews.Retry}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!-- Pestañas -->
      <StackPanel Orientation="Horizontal">
        <Button Classes="rv-tab" Classes.sel="{Binding IsSummaryTab}" Command="{Binding SelectTabCommand}"
                Content="{DynamicResource Text.Rama.Reviews.Tab.Summary}">
          <Button.CommandParameter><x:Int32>0</x:Int32></Button.CommandParameter>
        </Button>
        <Button Classes="rv-tab" Command="{Binding SelectTabCommand}" Content="{DynamicResource Text.Rama.Reviews.Tab.Files}">
          <Button.CommandParameter><x:Int32>1</x:Int32></Button.CommandParameter>
        </Button>
        <Button Classes="rv-tab" Command="{Binding SelectTabCommand}">
          <Button.CommandParameter><x:Int32>2</x:Int32></Button.CommandParameter>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{DynamicResource Text.Rama.Reviews.Tab.Commits}"/>
            <TextBlock Classes="rv-faint" Text="{Binding CommitsCount}"/>
          </StackPanel>
        </Button>
        <Button Classes="rv-tab" Command="{Binding SelectTabCommand}" Content="{DynamicResource Text.Rama.Reviews.Tab.Conversation}">
          <Button.CommandParameter><x:Int32>3</x:Int32></Button.CommandParameter>
        </Button>
      </StackPanel>
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border1}" Margin="0,-13,0,0"/>

      <!-- Pestañas sin implementar -->
      <StackPanel IsVisible="{Binding IsOtherTab}" Spacing="8" Margin="0,8">
        <TextBlock Classes="rv-muted" Text="{DynamicResource Text.Rama.Reviews.TabLater}"/>
        <Button Command="{Binding OpenInAzureCommand}" Content="{DynamicResource Text.Rama.Reviews.OpenInAzure}" HorizontalAlignment="Left"/>
      </StackPanel>

      <!-- Resumen -->
      <StackPanel IsVisible="{Binding IsSummaryTab}" Spacing="16">
        <StackPanel IsVisible="{Binding IsLoading}" Spacing="10">
          <Border Classes="rv-skel" Width="240"/>
          <Border Classes="rv-skel"/>
          <Border Classes="rv-skel"/>
          <Border Classes="rv-skel" Width="320"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasDetail}" Spacing="16">
          <Border Classes="rv-card">
            <StackPanel>
              <TextBlock Classes="rv-h3" Margin="16,10" Text="{Binding PoliciesTitle}"/>
              <TextBlock Classes="rv-muted" Margin="16,0,16,10" IsVisible="{Binding !HasPolicies}"
                         Text="{DynamicResource Text.Rama.Reviews.NoPolicies}"/>
              <ItemsControl ItemsSource="{Binding Policies}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PolicyRowViewModel">
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border1}" Padding="16,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG1}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding Ink}" Margin="12,0,0,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="rv-card">
            <StackPanel>
              <TextBlock Classes="rv-h3" Margin="16,10" Text="{DynamicResource Text.Rama.Reviews.Reviewers}"/>
              <ItemsControl ItemsSource="{Binding Reviewers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReviewerRowViewModel">
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border1}" Padding="16,8">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Classes="rv-avatar" Background="{Binding AvatarBackground}" Margin="0,0,10,0">
                          <TextBlock Text="{Binding Initials}" Foreground="{Binding AvatarInk}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.FG1}"/>
                          <TextBlock Classes="rv-faint" Text="{DynamicResource Text.Rama.Reviews.You}" IsVisible="{Binding IsMe}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="2" Classes="rv-pill" Background="{Binding PillBackground}">
                          <TextBlock Text="{Binding VoteLabel}" Foreground="{Binding PillInk}"/>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="rv-card" Padding="16,12">
            <StackPanel Spacing="6">
              <TextBlock Classes="rv-h3" Text="{DynamicResource Text.Rama.Reviews.Description}"/>
              <TextBlock Classes="rv-muted" Text="{Binding Description}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
