<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="52" d:DesignHeight="450"
             x:Class="SourceGit.Views.IconRail"
             x:DataType="vm:RailNavigator">
  <UserControl.Resources>
    <!-- Glifos de la maqueta (viewBox 16x16, solo contorno) -->
    <StreamGeometry x:Key="RailIcon.Repository">M5.6,3.5 A1.6,1.6 0 1 0 2.4,3.5 A1.6,1.6 0 1 0 5.6,3.5 Z M5.6,12.5 A1.6,1.6 0 1 0 2.4,12.5 A1.6,1.6 0 1 0 5.6,12.5 Z M13.6,5.5 A1.6,1.6 0 1 0 10.4,5.5 A1.6,1.6 0 1 0 13.6,5.5 Z M4,5.1 V10.9 M12,7.1 C12,9.5 10,10.4 5.6,11.5</StreamGeometry>
    <StreamGeometry x:Key="RailIcon.Reviews">M5.6,3.5 A1.6,1.6 0 1 0 2.4,3.5 A1.6,1.6 0 1 0 5.6,3.5 Z M5.6,12.5 A1.6,1.6 0 1 0 2.4,12.5 A1.6,1.6 0 1 0 5.6,12.5 Z M13.6,12.5 A1.6,1.6 0 1 0 10.4,12.5 A1.6,1.6 0 1 0 13.6,12.5 Z M4,5.1 V10.9 M12,10.9 V6.5 A2,2 0 0 0 10,4.5 H7.5 M9,3 L7.5,4.5 L9,6</StreamGeometry>
    <StreamGeometry x:Key="RailIcon.Board">M3.5,2.5 H12.5 A1.5,1.5 0 0 1 14,4 V12 A1.5,1.5 0 0 1 12.5,13.5 H3.5 A1.5,1.5 0 0 1 2,12 V4 A1.5,1.5 0 0 1 3.5,2.5 Z M6,2.5 V13.5 M10,2.5 V13.5</StreamGeometry>
    <StreamGeometry x:Key="RailIcon.Clone">M8,2.5 V10.5 M5,7.5 L8,10.5 L11,7.5 M3,13.5 H13</StreamGeometry>
    <StreamGeometry x:Key="RailIcon.Terminal">M3,2.5 H13 A1.5,1.5 0 0 1 14.5,4 V12 A1.5,1.5 0 0 1 13,13.5 H3 A1.5,1.5 0 0 1 1.5,12 V4 A1.5,1.5 0 0 1 3,2.5 Z M4.5,6 L6.5,8 L4.5,10 M8.5,10.5 H11.5</StreamGeometry>
    <StreamGeometry x:Key="RailIcon.Accounts">M6.5,9.5 L9.5,6.5 M7,4.2 L8.1,3.1 A2.6,2.6 0 0 1 11.8,6.8 L10.7,7.9 M9,11.8 L7.9,12.9 A2.6,2.6 0 0 1 4.2,9.2 L5.3,8.1</StreamGeometry>
    <StreamGeometry x:Key="RailIcon.Settings">M10.2,8 A2.2,2.2 0 1 0 5.8,8 A2.2,2.2 0 1 0 10.2,8 Z M8,1.8 V3.4 M8,12.6 V14.2 M14.2,8 H12.6 M3.4,8 H1.8 M12.4,3.6 L11.3,4.7 M4.7,11.3 L3.6,12.4 M12.4,12.4 L11.3,11.3 M4.7,4.7 L3.6,3.6</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8C8F96"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Focusable" Value="True"/>
    </Style>
    <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Popup}"/>
      <Setter Property="Foreground" Value="#ECECEC"/>
    </Style>
    <Style Selector="Button.rail.active /template/ ContentPresenter#PART_ContentPresenter, Button.rail.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2C2E33"/>
      <Setter Property="Foreground" Value="#ECECEC"/>
    </Style>
    <Style Selector="Button.rail:focus-visible">
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.rail Path.glyph">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Stretch" Value="None"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Fill" Value="Transparent"/>
      <Setter Property="Stroke" Value="#8C8F96"/>
    </Style>
    <Style Selector="Button.rail:pointerover Path.glyph, Button.rail.active Path.glyph, Button.rail:focus Path.glyph">
      <Setter Property="Stroke" Value="#ECECEC"/>
    </Style>
  </UserControl.Styles>

  <Border Width="52" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Border2}" Background="{DynamicResource Brush.ToolBar}">
    <DockPanel Margin="0,10">
      <Button DockPanel.Dock="Bottom" HorizontalAlignment="Center" Classes="rail"
              Command="{Binding OpenSettingsCommand}"
              ToolTip.Tip="{DynamicResource Text.Rama.Rail.Settings}"
              AutomationProperties.Name="{DynamicResource Text.Rama.Rail.Settings}">
        <Path Classes="glyph" Data="{StaticResource RailIcon.Settings}"/>
      </Button>

      <!-- RAMA: Cuentas (encima de Ajustes) -->
      <Button DockPanel.Dock="Bottom" HorizontalAlignment="Center" Classes="rail" Classes.active="{Binding IsAccounts}" Margin="0,0,0,4"
              Command="{Binding ShowCommand}" CommandParameter="{x:Static vm:RailDestination.Accounts}"
              ToolTip.Tip="{DynamicResource Text.Rama.Rail.Accounts}"
              AutomationProperties.Name="{DynamicResource Text.Rama.Rail.Accounts}">
        <Path Classes="glyph" Data="{StaticResource RailIcon.Accounts}"/>
      </Button>

      <StackPanel Spacing="4" HorizontalAlignment="Center">
        <!-- RAMA: marca -->
        <Image Width="22" Height="22" Margin="0,7,0,14" Source="avares://SourceGit/Rama/Resources/Images/rama-mark.png"
               AutomationProperties.Name="Rama"/>

        <Button Classes="rail" Classes.active="{Binding IsRepository}"
                Command="{Binding ShowCommand}" CommandParameter="{x:Static vm:RailDestination.Repository}"
                ToolTip.Tip="{DynamicResource Text.Rama.Rail.Repository}"
                AutomationProperties.Name="{DynamicResource Text.Rama.Rail.Repository}">
          <Path Classes="glyph" Data="{StaticResource RailIcon.Repository}"/>
        </Button>

        <Button Classes="rail" Classes.active="{Binding IsPendingReviews}"
                Command="{Binding ShowCommand}" CommandParameter="{x:Static vm:RailDestination.PendingReviews}"
                ToolTip.Tip="{DynamicResource Text.Rama.Rail.PendingReviews}"
                AutomationProperties.Name="{DynamicResource Text.Rama.Rail.PendingReviews}">
          <Grid Width="36" Height="36">
            <Path Classes="glyph" Data="{StaticResource RailIcon.Reviews}"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,1,0"
                    MinWidth="16" Height="16" Padding="3,0" CornerRadius="8"
                    Background="#3A2F1A" IsVisible="{Binding HasPendingReviews}">
              <TextBlock Text="{Binding PendingReviewsCount}" FontSize="10" FontWeight="SemiBold"
                         Foreground="#F0C27A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
        </Button>

        <Button Classes="rail" Classes.active="{Binding IsJiraBoard}"
                Command="{Binding ShowCommand}" CommandParameter="{x:Static vm:RailDestination.JiraBoard}"
                ToolTip.Tip="{DynamicResource Text.Rama.Rail.JiraBoard}"
                AutomationProperties.Name="{DynamicResource Text.Rama.Rail.JiraBoard}">
          <Path Classes="glyph" Data="{StaticResource RailIcon.Board}"/>
        </Button>

        <Button Classes="rail"
                Command="{Binding CloneCommand}"
                ToolTip.Tip="{DynamicResource Text.Rama.Rail.Clone}"
                AutomationProperties.Name="{DynamicResource Text.Rama.Rail.Clone}">
          <Path Classes="glyph" Data="{StaticResource RailIcon.Clone}"/>
        </Button>

        <Button Classes="rail" Classes.active="{Binding IsTerminal}"
                Command="{Binding ShowCommand}" CommandParameter="{x:Static vm:RailDestination.Terminal}"
                ToolTip.Tip="{DynamicResource Text.Rama.Rail.Terminal}"
                AutomationProperties.Name="{DynamicResource Text.Rama.Rail.Terminal}">
          <Path Classes="glyph" Data="{StaticResource RailIcon.Terminal}"/>
        </Button>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
