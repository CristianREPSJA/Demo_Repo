<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rt="using:SourceGit.Rama.Terminal"
             x:Class="SourceGit.Views.TerminalPage">
  <!-- Terminal del repositorio activo; sin repositorio muestra un aviso -->
  <Grid>
    <TextBlock x:Name="EmptyMessage"
               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
               TextWrapping="Wrap" TextAlignment="Center"
               Foreground="{DynamicResource Brush.FG2}"
               Text="{DynamicResource Text.Rama.Terminal.NoRepository}"/>
    <rt:TerminalHost x:Name="Host"/>
  </Grid>
</UserControl>
