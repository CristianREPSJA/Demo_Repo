<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:rt="using:SourceGit.Rama.Terminal"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="400"
             x:Class="SourceGit.Rama.Terminal.TerminalPanelView"
             x:DataType="rt:TerminalPanel"
             Background="#111214">
  <!-- Paleta de docs/mockups/Terminal.html -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="Rama.Term.Ground" Color="#17181A"/>
    <SolidColorBrush x:Key="Rama.Term.Surface" Color="#1D1E21"/>
    <SolidColorBrush x:Key="Rama.Term.Raised" Color="#25272B"/>
    <SolidColorBrush x:Key="Rama.Term.Rule" Color="#222327"/>
    <SolidColorBrush x:Key="Rama.Term.Control" Color="#3A3D43"/>
    <SolidColorBrush x:Key="Rama.Term.Text" Color="#ECECEC"/>
    <SolidColorBrush x:Key="Rama.Term.Muted" Color="#A9ABB1"/>
    <SolidColorBrush x:Key="Rama.Term.Faint" Color="#8C8F96"/>
    <SolidColorBrush x:Key="Rama.Term.Amber" Color="#E6A23C"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.term-tab">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Rama.Term.Muted}"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.term-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Rama.Term.Raised}"/>
      <Setter Property="Foreground" Value="{StaticResource Rama.Term.Text}"/>
    </Style>
    <Style Selector="Button.term-tab.selected">
      <Setter Property="Foreground" Value="{StaticResource Rama.Term.Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rama.Term.Amber}"/>
    </Style>
    <Style Selector="Button.term-tab.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource Rama.Term.Amber}"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Rama.Term.Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rama.Term.Control}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Rama.Term.Raised}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rama.Term.Control}"/>
      <Setter Property="Foreground" Value="{StaticResource Rama.Term.Text}"/>
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Rama.Term.Faint}"/>
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource Rama.Term.Amber}"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Pestañas -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Rama.Term.Surface}"
            BorderBrush="{StaticResource Rama.Term.Rule}" BorderThickness="0,0,0,1" Padding="8,0">
      <DockPanel>
        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rt:TerminalTab">
              <Button Classes="term-tab" Classes.selected="{Binding IsSelected}" Click="OnTabClick"
                      ToolTip.Tip="{Binding Error}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Fill="Transparent" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                        StrokeLineCap="Round" StrokeJoin="Round"
                        Data="M3,2.5 H13 A1.5,1.5 0 0 1 14.5,4 V12 A1.5,1.5 0 0 1 13,13.5 H3 A1.5,1.5 0 0 1 1.5,12 V4 A1.5,1.5 0 0 1 3,2.5 Z M4.5,6 L6.5,8 L4.5,10 M8.5,10.5 H11.5"/>
                  <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource Fonts.Monospace}" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Rama.Term.Faint}" VerticalAlignment="Center"
                             IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding DirectoryLabel}" FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11"
                   Foreground="{StaticResource Rama.Term.Faint}" HorizontalAlignment="Right" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="16,0,4,0"/>
      </DockPanel>
    </Border>

    <!-- Acciones de contexto -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Rama.Term.Ground}"
            BorderBrush="{StaticResource Rama.Term.Rule}" BorderThickness="0,0,0,1" Padding="12,8">
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
        <Button Classes="ghost" Content="Explicar cambios seleccionados" IsEnabled="{Binding CanExplain}" Click="OnExplainClick"/>
        <Button Classes="ghost" Content="Redactar mensaje de commit" IsEnabled="{Binding CanCommit}" Click="OnCommitClick"/>
        <Button Classes="ghost" Content="{Binding ReviewLabel}" IsEnabled="{Binding CanReview}" Click="OnReviewClick"/>
        <Button Classes="ghost" Content="{Binding SummarizeLabel}" IsEnabled="{Binding CanSummarize}" IsVisible="{Binding HasTicket}" Click="OnSummarizeClick"/>
        <TextBlock Text="{x:Static rt:TerminalPanel.Note}" FontSize="11" Foreground="{StaticResource Rama.Term.Faint}"
                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
      </WrapPanel>
    </Border>

    <!-- Línea de estado -->
    <Border DockPanel.Dock="Bottom" Height="24" Background="{StaticResource Rama.Term.Ground}"
            BorderBrush="{StaticResource Rama.Term.Rule}" BorderThickness="0,1,0,0" Padding="16,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" FontFamily="{DynamicResource Fonts.Monospace}" FontSize="11"
                   Foreground="{StaticResource Rama.Term.Faint}" VerticalAlignment="Center" xml:space="preserve"/>
        <TextBlock Text="{x:Static rt:TerminalPanel.Disclaimer}" FontSize="11" Foreground="{StaticResource Rama.Term.Faint}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
      </DockPanel>
    </Border>

    <!-- Área de terminal: un host por pestaña, se ocultan en vez de quitarse para no matar el PTY -->
    <Grid x:Name="TerminalHost" Background="#111214"/>
  </DockPanel>
</UserControl>
